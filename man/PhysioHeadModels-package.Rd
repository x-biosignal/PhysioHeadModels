\itemize{
\item \code{\link[=icosphere]{icosphere()}} - triangulated sphere (subdivided icosahedron) for a
scalp/skull/brain surface or electrode placement.
\item \code{\link[=sphericalSourceSpace]{sphericalSourceSpace()}} - dipole positions and radial normals on a
spherical-cortex shell.
}
}

\section{Analytic forward model}{

\itemize{
\item \code{\link[=sphereLeadfield]{sphereLeadfield()}} - Legendre-series leadfield for a homogeneous
conducting sphere (the classic single-sphere analytic solution).
}
}

\section{Boundary-element forward model}{

\itemize{
\item \code{\link[=bemLeadfield]{bemLeadfield()}} - double-layer collocation BEM leadfield on one or
more nested meshes.
\item \code{\link[=solidAngle]{solidAngle()}} - van Oosterom-Strackee solid angle used by the solver.
}
}

\section{Orientation and validation}{

